<?xml version="1.0" encoding="UTF-8"?>
<!-- Song lyrics overlay, fed by plugin.video.kofin.

     Kodi's music database has no lyrics column, so lyrics only ever exist on
     the playback that is running. An addon cannot draw them passively either:
     a Python window shown over playback becomes the *active* window and
     swallows navigation and the OSD. A skin control belongs to the window
     that is already active, so it costs nothing and blocks nothing — which is
     why this lives here rather than in the addon.

     Kofin publishes a fixed ladder of window properties on Home, because skin
     XML cannot iterate a list. The line being sung is always in the middle
     slot, so this styles one constant index and never computes anything:
     scrolling is the text changing underneath a static ladder. Slots beyond
     either end of the song arrive empty, so lyrics scroll in and out.

       kofin.lyric.has     non-empty while lyrics are up (the visibility gate)
       kofin.lyric.active  non-empty when a line is current; empty for
                           unsynced lyrics, which have nothing to highlight
       kofin.lyric.0..8    the ladder; 4 is the current line
-->
<includes>
	<!-- One rung. Kept as an include so the ladder below is nine lines rather
	     than nine near-identical control blocks. -->
	<include name="KofinLyricLine">
		<param name="slot">0</param>
		<param name="font">font27</param>
		<param name="color">C0FFFFFF</param>
		<param name="visible">true</param>
		<definition>
			<control type="label">
				<width>600</width>
				<height>88</height>
				<font>$PARAM[font]</font>
				<textcolor>$PARAM[color]</textcolor>
				<shadowcolor>black</shadowcolor>
				<align>center</align>
				<aligny>center</aligny>
				<scroll>true</scroll>
				<visible>$PARAM[visible]</visible>
				<label>$INFO[Window(Home).Property(kofin.lyric.$PARAM[slot])]</label>
			</control>
		</definition>
	</include>

	<include name="KofinLyricsOverlay">
		<control type="group">
			<!-- 40 from the right edge, 100 below the top, 180 above the
			     bottom: 1080 - 100 - 180 = 800. Authored in the skin's own
			     coordinate space, so it tracks resolution changes with
			     everything else. -->
			<right>40</right>
			<width>640</width>
			<top>100</top>
			<height>800</height>
			<include>Visible_Right</include>
			<!-- The track-info panel is bottom-anchored and its labels run out
			     to x=1890, so it collides with this whenever info or the OSD
			     is up. Yielding is the default; kofin_lyrics_over_osd keeps
			     both on screen for anyone who would rather have the overlap. -->
			<visible>!String.IsEmpty(Window(Home).Property(kofin.lyric.has)) + [Skin.HasSetting(kofin_lyrics_over_osd) | ![Player.ShowInfo | Window.IsActive(musicosd)]]</visible>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>640</width>
				<height>800</height>
				<!-- The same texture and diffuse the track-info panel uses, so
				     the two read as one surface rather than two dialogs. -->
				<texture colordiffuse="80FFFFFF">dialogs/dialog-bg-nobo.png</texture>
			</control>
			<control type="grouplist">
				<left>20</left>
				<top>4</top>
				<width>600</width>
				<height>792</height>
				<orientation>vertical</orientation>
				<itemgap>0</itemgap>
				<include content="KofinLyricLine"><param name="slot" value="0"/></include>
				<include content="KofinLyricLine"><param name="slot" value="1"/></include>
				<include content="KofinLyricLine"><param name="slot" value="2"/></include>
				<include content="KofinLyricLine"><param name="slot" value="3"/></include>
				<!-- The line being sung, twice over: unsynced lyrics have no
				     current line, and lighting the middle of a static block
				     would be pointing at an arbitrary one. A grouplist skips
				     hidden children, so exactly one of these takes the slot. -->
				<include content="KofinLyricLine">
					<param name="slot" value="4"/>
					<param name="font" value="font32"/>
					<param name="color" value="FFFFFFFF"/>
					<param name="visible" value="!String.IsEmpty(Window(Home).Property(kofin.lyric.active))"/>
				</include>
				<include content="KofinLyricLine">
					<param name="slot" value="4"/>
					<param name="visible" value="String.IsEmpty(Window(Home).Property(kofin.lyric.active))"/>
				</include>
				<include content="KofinLyricLine"><param name="slot" value="5"/></include>
				<include content="KofinLyricLine"><param name="slot" value="6"/></include>
				<include content="KofinLyricLine"><param name="slot" value="7"/></include>
				<include content="KofinLyricLine"><param name="slot" value="8"/></include>
			</control>
		</control>
	</include>
</includes>
