<?xml version="1.0" encoding="utf-8"?>
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="button">
			<description>background close area</description>
			<left>0</left>
			<top>0</top>
			<width>100%</width>
			<height>100%</height>
			<texturefocus />
			<texturenofocus />
			<onclick>Action(close)</onclick>
		</control>
		<control type="group">
			<left>0</left>
			<bottom>150</bottom>
			<width>100%</width>
			<height>430</height>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>100%</width>
				<height>430</height>
				<texture colordiffuse="CC000000">colors/white.png</texture>
			</control>
			<control type="fixedlist" id="50">
				<description>the preview thumbnails, one per interval, the one in the middle selected</description>
				<left>-300</left>
				<top>10</top>
				<width>2520</width>
				<height>340</height>
				<orientation>horizontal</orientation>
				<focusposition>3</focusposition>
				<movement>0</movement>
				<scrolltime tween="sine">200</scrolltime>
				<preloaditems>2</preloaditems>
				<itemlayout width="360" height="340">
					<control type="group">
						<left>15</left>
						<control type="image">
							<left>0</left>
							<top>5</top>
							<width>330</width>
							<height>250</height>
							<aspectratio>scale</aspectratio>
							<texture>$INFO[ListItem.Art(thumb)]</texture>
							<region>$INFO[ListItem.Property(region)]</region>
						</control>
						<control type="label">
							<left>20</left>
							<top>255</top>
							<width>290</width>
							<height>40</height>
							<label>$INFO[ListItem.Label]</label>
							<font>font12</font>
							<shadowcolor>text_shadow</shadowcolor>
							<align>center</align>
						</control>
					</control>
				</itemlayout>
				<focusedlayout width="360" height="340">
					<control type="group">
						<left>15</left>
						<control type="image">
							<left>0</left>
							<top>5</top>
							<width>330</width>
							<height>250</height>
							<aspectratio>scale</aspectratio>
							<texture>$INFO[ListItem.Art(thumb)]</texture>
							<region>$INFO[ListItem.Property(region)]</region>
						</control>
						<control type="label">
							<left>20</left>
							<top>255</top>
							<width>290</width>
							<height>40</height>
							<label>$INFO[ListItem.Label]</label>
							<font>font12</font>
							<shadowcolor>text_shadow</shadowcolor>
							<align>center</align>
						</control>
						<control type="image">
							<left>0</left>
							<top>5</top>
							<width>330</width>
							<height>250</height>
							<texture border="4" infill="false" colordiffuse="button_focus">colors/white.png</texture>
						</control>
					</control>
				</focusedlayout>
			</control>
			<control type="label">
				<left>0</left>
				<top>350</top>
				<width>100%</width>
				<height>45</height>
				<align>center</align>
				<aligny>center</aligny>
				<font>font37</font>
				<textcolor>white</textcolor>
				<label>$INFO[Window.Property(scrubtime)]</label>
			</control>
			<control type="label">
				<left>0</left>
				<top>393</top>
				<width>100%</width>
				<height>30</height>
				<align>center</align>
				<aligny>center</aligny>
				<font>font13</font>
				<textcolor>grey</textcolor>
				<label>$INFO[Window.Property(scrubdelta)]</label>
			</control>
		</control>
	</controls>
</window>
